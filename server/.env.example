# TELAWORK server configuration. Copy to .env and adjust.
NODE_ENV=development
# Em PaaS (ex.: alwaysdata), deixe PORT e HOST comentados: o provedor injeta
# PORT e IP. O servidor usa HOST, depois IP, e por fim 0.0.0.0.
PORT=60000
HOST=0.0.0.0

# REQUIRED in production: use a long random string (at least 32 characters).
JWT_SECRET=change-me-in-production-please-use-a-random-64-char-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# SQLite file (relative to server/). Created automatically.
DATABASE_PATH=./data/telawork.db

# Comma-separated allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_URL=http://localhost:5173

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25

# Email transport. "auto" uses SMTP when configured, otherwise the local
# sendmail binary (works on alwaysdata and most Linux hosts).
# MAIL_TRANSPORT=auto
# SENDMAIL_PATH=/usr/sbin/sendmail
# Optional SMTP. When unset and no sendmail exists, emails are logged instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="UNISON <no-reply@unison.local>"

# Testing/development only: expose password reset tokens in API responses.
EXPOSE_DEV_TOKENS=true
TRUST_PROXY=false

# Force Secure cookies. Defaults to true in production. Set false only for a
# loopback desktop build; never disable it on a public HTTPS deployment.
# COOKIE_SECURE=false
