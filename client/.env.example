# Frontend build/dev configuration. Copy to .env and adjust when needed.
# Leave VITE_API_URL unset/relative when the server serves the built frontend.

# Base URL of the API. Examples: /api or https://api.example.com/api
VITE_API_URL=/api

# Development proxy target (used by vite.config.ts, not embedded in the build).
VITE_DEV_API_TARGET=http://127.0.0.1:60000

# Comma-separated STUN servers.
VITE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Optional TURN relay for calls behind restrictive NAT. Rebuild after changing.
# VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
